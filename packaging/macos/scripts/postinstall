#!/bin/bash
set -u

# Installer scripts run as root and log to /var/log/install.log. Open
# first-run settings in the active user's GUI session without installing
# credentials or startup state as root.
APP="/Applications/WiFi Agent.app"
if [[ ! -d "$APP" ]]; then
    echo "WiFi Agent: $APP is missing after installation."
    exit 0
fi

CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" || "$CONSOLE_USER" == "loginwindow" ]]; then
    exit 0
fi

CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER")"
USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
LAUNCH_AGENT="$USER_HOME/Library/LaunchAgents/com.local.wifi-agent.plist"
if [[ -f "$LAUNCH_AGENT" ]]; then
    # Earlier packages could install the app outside /Applications, and the
    # Login Item still points there; move it to the copy just installed.
    EXECUTABLE="$APP/Contents/MacOS/WiFi Agent"
    CURRENT="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "$LAUNCH_AGENT" 2>/dev/null || true)"
    if [[ -n "$CURRENT" && "$CURRENT" != "$EXECUTABLE" ]]; then
        /usr/bin/sudo -u "$CONSOLE_USER" /usr/libexec/PlistBuddy \
            -c "Set :ProgramArguments:0 $EXECUTABLE" "$LAUNCH_AGENT" \
            || echo "WiFi Agent: could not update the Login Item path for $CONSOLE_USER."
    fi
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" \
        /bin/launchctl bootstrap "gui/$CONSOLE_UID" "$LAUNCH_AGENT" \
        || echo "WiFi Agent: could not restart the menu-bar agent for $CONSOLE_USER."
fi
# Open the installed bundle by path. Using `open -a` with a filesystem path can
# be interpreted as an application name and silently fail on some macOS builds.
/bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" \
    /usr/bin/open -n "$APP" --args setup \
    || echo "WiFi Agent: could not open $APP for $CONSOLE_USER."
exit 0
